# Which model backs the agents: "<provider>/<model name>".
# Providers: ollama, openai, anthropic, google, bedrock, bedrock-mantle, litellm
# Examples:
#   GENTUI_MODEL=ollama/gpt-oss:120b-cloud
#   GENTUI_MODEL=openai/<model>
#   GENTUI_MODEL=anthropic/<model>
GENTUI_MODEL=ollama/gpt-oss:120b-cloud

# Reasoning effort: auto | off | minimal | low | medium | high | xhigh | max
# (not every provider supports every level; Ollama ignores it)
GENTUI_EFFORT=auto

# --- Provider credentials: set only what your chosen provider needs. ---
# The harness reads these straight from the environment.
# Ollama: local host proxies *-cloud models after `ollama signin`.
# For direct cloud use OLLAMA_HOST=https://ollama.com and set OLLAMA_API_KEY.
OLLAMA_HOST=http://localhost:11434
# OLLAMA_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=
# AWS_PROFILE=  (Bedrock: standard AWS credentials)
